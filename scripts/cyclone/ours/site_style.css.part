<style>
/* Layout: one reading column; the map + input chips form a working panel; method notes below. */
:root{
  --bg:#0b1522; --panel:#122135; --ink:#e9f0f7; --muted:#8fa3bb; --line:#22344c; --sea:#0e1c2d; --landc:#1b2d45; --coast:#a9cbe2;
  --accent:#5ccfee; --chip:#1b2d45; --chip-on:#5ccfee; --chip-on-ink:#06222c;
  --tn:#d95926; --ap:#199e70; --north:#3987e5; --none:#6c7a82; --star:#ff6b5b;
  --i0:#7d8b96; --i1:#e2c55a; --i2:#efa23a; --i3:#ef7d3a; --i4:#ea5545; --i5:#d4405a; --i6:#c060a8; --i7:#a685f0;
  --f-display:"Anek Latin",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --f-body:"Anek Latin",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; --f-mono:ui-monospace,Menlo,Consolas,monospace;
  color-scheme:dark}
*{box-sizing:border-box}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 0 4px;flex-wrap:wrap;row-gap:10px}
.brand{display:flex;align-items:baseline;gap:10px;min-width:0;text-decoration:none;color:var(--ink)}
.ta{font:800 34px/0.9 "Anek Tamil",var(--f-body);color:var(--accent)}
.top h1{font:600 15px/1.15 var(--f-body);font-stretch:118%;margin:0;color:var(--muted)} .top h1 b{color:var(--ink);font-weight:700}
.tabs{display:flex;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:3px;flex:none;flex-wrap:wrap}
.tabs a{padding:6px 10px;border-radius:9px;text-decoration:none;color:var(--muted);font-weight:600;font-size:13px;white-space:nowrap}
.tabs a.on{background:var(--accent);color:#06222c}
.warnx{border-left:3px solid #e8a33a;padding:4px 0 4px 10px;font-size:14px}
body{margin:0}
h1.big{font-stretch:112%}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.5}
.wrap{max-width:1080px;margin:0 auto;padding-block:20px 48px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:28px}
h1,h2,h3{font-family:var(--f-display);font-weight:700;letter-spacing:.01em;text-wrap:balance;margin:0;line-height:1.1}
h1{font-size:clamp(2rem,5vw,2.9rem)} h2{font-size:1.6rem} h3{font-size:1.15rem;font-weight:600}
p{margin:0;max-width:68ch} .muted{color:var(--muted)} .mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.eyebrow{font-family:var(--f-mono);font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
header{display:grid;gap:10px}
.lede{font-size:1.12rem}
section{display:grid;gap:14px}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:16px}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.fact{display:grid;gap:2px;padding:12px 14px;border-left:3px solid var(--line)}
.fact b{font-family:var(--f-display);font-size:1.5rem;font-weight:600} .fact span{font-size:.9rem;color:var(--muted)}
.fact.tn{border-left-color:var(--tn)}
.work{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:18px;align-items:start}
@media (max-width:820px){.work{grid-template-columns:minmax(0,1fr)}}
.mapbox{position:relative;background:var(--sea);border:1px solid var(--line);border-radius:10px;overflow:hidden}
canvas{display:block;width:100%;height:auto;touch-action:manipulation}
.tip{position:absolute;pointer-events:none;background:var(--panel);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:.8rem;line-height:1.35;max-width:260px;box-shadow:0 4px 18px rgba(0,0,0,.18)}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:.85rem;color:var(--muted)}
.legend i{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.shares{display:grid;gap:6px}
.row{display:grid;grid-template-columns:9.5em minmax(0,1fr) 3.4em;gap:8px;align-items:center;font-size:.92rem}
.bar{height:12px;background:var(--chip);border-radius:6px;overflow:hidden}
.bar>div{height:100%;border-radius:6px;transition:width .25s}
.row .v{text-align:right;font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.count{font-family:var(--f-mono);font-size:.85rem;color:var(--muted)}
.filters{display:grid;gap:12px}
.fg{display:grid;gap:6px}
.fg h4{margin:0;font-size:.8rem;font-family:var(--f-mono);font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font:inherit;font-size:.86rem;border:1px solid var(--line);background:var(--chip);color:var(--ink);border-radius:999px;padding:5px 11px;cursor:pointer}
.chip[aria-pressed="true"]{background:var(--chip-on);color:var(--chip-on-ink);border-color:var(--chip-on)}
.chip:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn{font:inherit;font-size:.86rem;border:1px solid var(--accent);color:var(--accent);background:transparent;border-radius:6px;padding:5px 12px;cursor:pointer}
details{border-top:1px solid var(--line);padding-top:10px} summary{cursor:pointer;font-weight:600;color:var(--accent)}
details .filters{margin-top:12px}
.drivers{display:grid;gap:7px}
.drow{display:grid;grid-template-columns:minmax(0,15em) minmax(0,1fr);gap:10px;align-items:center;font-size:.9rem}
.track{position:relative;height:16px;overflow:hidden}
.track .rng{position:absolute;top:5px;height:6px;background:var(--accent);border-radius:3px}
.track .mid{position:absolute;top:0;bottom:0;width:1px;background:var(--muted);opacity:.6}
.axis{display:grid;grid-template-columns:minmax(0,15em) minmax(0,1fr);gap:10px;font-family:var(--f-mono);font-size:.72rem;color:var(--muted)}
.axis div:last-child{display:flex;justify-content:space-between}
table{border-collapse:collapse;width:100%;font-size:.88rem}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-family:var(--f-mono);font-size:.72rem;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-weight:500}
td.n{font-family:var(--f-mono);font-variant-numeric:tabular-nums;text-align:right}
.tblwrap{overflow-x:auto}
ul{margin:0;padding-left:1.2em;display:grid;gap:4px;max-width:70ch}
a{color:var(--accent)}
.note{font-size:.9rem;color:var(--muted)}
@media (max-width:520px){.drow,.axis{grid-template-columns:minmax(0,1fr)}.axis span:first-child{display:none}.row{grid-template-columns:8.5em minmax(0,1fr) 3em}}
@media (prefers-reduced-motion:reduce){.bar>div{transition:none}}
.dlrow,.memctl{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.memctl select{flex:1 1 9em;min-width:0;width:100%;font:inherit;font-size:.95rem;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:6px 10px;max-width:100%}
</style>